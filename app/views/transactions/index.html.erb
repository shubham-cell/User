<% content_for :title, "Your transactions" %>

<div class="page-header">
  <div>
    <h1>Your transactions</h1>
    <p class="lede">Track credits, debits, and remaining budget.</p>
  </div>
  <div class="actions-row">
    <%= link_to "Create transaction", new_transaction_path, class: "btn btn-success" %>
    <%= link_to "Generate report", new_report_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="stats-row">
  <div class="stat-card">
    <span>Original budget</span>
    <strong><%= @user.budget&.amount || 0 %></strong>
  </div>
  <div class="stat-card">
    <span>Remaining balance</span>
    <strong><%= @user.balance_amount&.amount || 0 %></strong>
  </div>
</div>

<div class="card">
  <% if @transactions.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Amount</th>
            <th>Description</th>
            <th>Date</th>
            <th>Type</th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <% credit = transaction.transaction_category.to_i.zero? %>
            <tr>
              <td class="<%= credit ? 'amount-credit' : 'amount-debit' %>"><%= transaction.amount %></td>
              <td><%= transaction.description %></td>
              <td><%= transaction.created_at.strftime("%d-%m-%Y") %></td>
              <td class="<%= credit ? 'amount-credit' : 'amount-debit' %>">
                <%= credit ? "Credit" : "Debit" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No transactions yet. Create one to start tracking your budget.</p>
    </div>
  <% end %>
</div>
