<% content_for :title, "Create transaction" %>

<div class="page-header">
  <div>
    <h1>Create transaction</h1>
    <p class="lede">Remaining balance: <strong><%= @user.balance_amount&.amount || 0 %></strong></p>
  </div>
</div>

<div class="card">
  <%= form_with model: @transaction, url: transactions_path, local: true do |form| %>
    <div class="field">
      <%= form.label :amount, "Transaction amount" %>
      <%= form.number_field :amount, required: true, min: 0, step: 0.01, class: "input-field" %>
    </div>

    <div class="field">
      <%= form.label :description, "Description" %>
      <%= form.text_field :description, required: true, class: "input-field" %>
    </div>

    <div class="field">
      <label>Transaction type</label>
      <div class="radio-group">
        <label>
          <%= form.radio_button :transaction_category, 0, checked: true, class: "radio-input" %>
          Credit
        </label>
        <label>
          <%= form.radio_button :transaction_category, 1, class: "radio-input" %>
          Debit
        </label>
      </div>
    </div>

    <div class="form-actions">
      <%= form.submit "Create transaction", class: "btn btn-success" %>
      <%= link_to "Back to transactions", transactions_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
