<% content_for :title, "Create budget" %>

<div class="page-header">
  <div>
    <h1>Create a budget</h1>
    <p class="lede">Your remaining balance starts from this amount.</p>
  </div>
</div>

<div class="card">
  <%= form_with(model: @budget, url: budgets_path, local: true) do |form| %>
    <div class="field">
      <%= form.label :amount, "Budget amount" %>
      <%= form.number_field :amount, required: true, min: 0, step: 0.01, class: "input-field" %>
    </div>

    <div class="field">
      <label>Category</label>
      <div class="radio-group">
        <label>
          <%= form.radio_button :budget_category, 0, checked: true, class: "radio-input" %>
          Income
        </label>
        <label>
          <%= form.radio_button :budget_category, 1, class: "radio-input" %>
          Expense
        </label>
      </div>
    </div>

    <div class="form-actions">
      <%= form.submit "Create budget", class: "btn btn-primary" %>
      <%= link_to "Back to profile", profile_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
