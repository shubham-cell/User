<% content_for :title, "Login" %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="lede">Sign in to manage your budget and reports.</p>

    <%= form_with(url: login_path, local: true) do |form| %>
      <div class="field">
        <%= form.label :email %>
        <%= form.email_field :email, required: true %>
      </div>

      <div class="field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true %>
      </div>

      <div class="actions">
        <%= form.submit "Login", class: "btn btn-primary" %>
      </div>
    <% end %>

    <p class="signup-link">
      Don't have an account? <%= link_to "Sign up here", new_new_user_path %>
    </p>
  </div>
</div>
