<% content_for :title, "Your profile" %>

<div class="page-header">
  <div>
    <h1>Welcome, <%= @user.name %></h1>
    <p class="lede">Set a budget to start adding transactions.</p>
  </div>
</div>

<div class="card">
  <% unless @budget.persisted? %>
    <div class="budget-container">
      <h2>Create a budget</h2>
      <%= form_with model: @budget, url: budgets_path, local: true, html: { class: "budget-form" } do |form| %>
        <div class="field">
          <%= form.label :amount, "Budget amount" %>
          <%= form.number_field :amount, required: true, min: 0, step: 0.01, class: "input-field" %>
        </div>

        <div class="field">
          <label>Category</label>
          <div class="radio-group">
            <label>
              <%= form.radio_button :budget_category, 0, checked: true, class: "radio-input" %>
              Income
            </label>
            <label>
              <%= form.radio_button :budget_category, 1, class: "radio-input" %>
              Expense
            </label>
          </div>
        </div>

        <div class="form-actions">
          <%= form.submit "Create budget", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
