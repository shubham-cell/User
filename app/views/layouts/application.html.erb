<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <% if logged_in? %>
        <header class="topbar">
          <div class="topbar-brand">
            <%= link_to "Ledger", transactions_path, class: "brand-link" %>
          </div>
          <nav class="topbar-nav">
            <%= link_to "Transactions", transactions_path, class: "nav-link" %>
            <%= link_to "New transaction", new_transaction_path, class: "nav-link" %>
            <%= link_to "Reports", reports_path, class: "nav-link" %>
            <%= link_to "Logout", logout_path, class: "nav-link nav-link-danger" %>
          </nav>
        </header>
      <% end %>

      <main class="<%= logged_in? ? 'page' : 'guest-page' %>">
        <% if flash[:notice].present? %>
          <p class="flash flash-success"><%= flash[:notice] %></p>
        <% end %>
        <% if flash[:alert].present? %>
          <p class="flash flash-error"><%= flash[:alert] %></p>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
